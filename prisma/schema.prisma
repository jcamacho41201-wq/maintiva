generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
}

enum ShopStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  WATCHLIST
  PAUSED
  ARCHIVED
}

enum ContactMethod {
  SMS
  EMAIL
  CALL
}

enum MaintenanceStatus {
  HEALTHY
  DUE_SOON
  DUE
  OVERDUE
  PAUSED
  COMPLETED
}

enum OutreachStatus {
  NEEDS_OUTREACH
  DRAFTED
  MANUALLY_SENT
  SCHEDULED
  DECLINED
}

enum OutreachChannel {
  SMS
  EMAIL
  CALL
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  AUTOMATION
  CUSTOMER_BOOKING
  MANUAL
  IMPORTED
}

model User {
  id          String           @id
  email       String           @unique
  name        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships ShopMembership[]
  auditLogs   AuditLog[]
}

model Shop {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  phone                String?
  email                String?
  address              String?
  timezone             String                     @default("America/New_York")
  dailyBayHours        Int                        @default(64)
  status               ShopStatus                 @default(ONBOARDING)
  isDemo               Boolean                    @default(false)
  onboardingCompletedAt DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  memberships          ShopMembership[]
  customers            Customer[]
  vehicles             Vehicle[]
  serviceDefinitions   ServiceDefinition[]
  maintenanceRecords   VehicleMaintenanceRecord[]
  serviceHistoryRecords ServiceHistoryRecord[]
  outreachRecords      OutreachRecord[]
  appointments         Appointment[]
  appointmentServices  AppointmentService[]
  auditLogs            AuditLog[]

  @@index([status])
}

model ShopMembership {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      UserRole @default(OWNER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId, isActive])
  @@index([shopId, role])
}

model Customer {
  id                   String                 @id @default(cuid())
  shopId               String
  firstName            String
  lastName             String
  phone                String?
  email                String?
  preferredContact     ContactMethod          @default(SMS)
  smsConsent           Boolean                @default(false)
  emailConsent         Boolean                @default(false)
  callConsent          Boolean                @default(false)
  address              String?
  notes                String?
  status               CustomerStatus         @default(ACTIVE)
  customerScore        Int                    @default(70)
  lifetimeRevenueCents Int                    @default(0)
  lastVisit            DateTime?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  shop                 Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicles             Vehicle[]
  serviceHistoryRecords ServiceHistoryRecord[]
  outreachRecords      OutreachRecord[]
  appointments         Appointment[]

  @@index([shopId, status])
  @@index([shopId, archivedAt])
  @@index([shopId, lastName, firstName])
}

model Vehicle {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  year                  Int
  make                  String
  model                 String
  vin                   String?
  licensePlate          String?
  engine                String?
  trim                  String?
  vehicleType           String?
  currentMileage        Int                        @default(0)
  estimatedAnnualMileage Int?
  overallHealth         Int                        @default(80)
  lastServiceDate       DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  maintenanceRecords    VehicleMaintenanceRecord[]
  serviceHistoryRecords ServiceHistoryRecord[]
  outreachRecords       OutreachRecord[]
  appointments          Appointment[]

  @@index([shopId, customerId])
  @@index([shopId, archivedAt])
  @@unique([shopId, vin])
}

model ServiceDefinition {
  id                           String                     @id @default(cuid())
  shopId                       String
  name                         String
  category                     String
  defaultMileageInterval       Int
  defaultTimeIntervalMonths    Int
  defaultNotificationThreshold Int                        @default(10)
  estimatedLaborMinutes        Int
  defaultPriceCents            Int
  description                  String?
  isActive                     Boolean                    @default(true)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  shop                         Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  maintenanceRecords           VehicleMaintenanceRecord[]
  serviceHistoryRecords        ServiceHistoryRecord[]
  appointmentServices          AppointmentService[]

  @@unique([shopId, name])
  @@index([shopId, isActive])
}

model VehicleMaintenanceRecord {
  id                              String                 @id @default(cuid())
  shopId                          String
  vehicleId                       String
  serviceDefinitionId             String
  serviceName                     String
  lastCompletedDate               DateTime?
  lastCompletedMileage            Int?
  recommendedMileageInterval      Int
  recommendedTimeIntervalMonths   Int
  notificationThreshold           Int                    @default(10)
  priceCents                      Int
  laborMinutes                    Int
  status                          MaintenanceStatus      @default(HEALTHY)
  outreachStatus                  OutreachStatus         @default(NEEDS_OUTREACH)
  outreachRecordId                String?
  appointmentId                   String?
  archivedAt                      DateTime?
  notes                           String?
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt
  shop                            Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicle                         Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDefinition               ServiceDefinition      @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  outreachRecord                  OutreachRecord?        @relation(fields: [outreachRecordId], references: [id], onDelete: SetNull)
  appointment                     Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceHistoryRecords           ServiceHistoryRecord[]
  appointmentServices             AppointmentService[]

  @@unique([shopId, vehicleId, serviceDefinitionId])
  @@index([shopId, vehicleId, status])
  @@index([shopId, outreachStatus])
}

model ServiceHistoryRecord {
  id                    String                    @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  serviceDefinitionId   String?
  maintenanceRecordId   String?
  serviceName           String
  completedAt           DateTime
  mileage               Int?
  laborMinutes          Int                       @default(0)
  priceCents            Int                       @default(0)
  notes                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDefinition     ServiceDefinition?        @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, customerId, completedAt])
  @@index([shopId, vehicleId, completedAt])
}

model OutreachRecord {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  message               String
  channel               OutreachChannel            @default(SMS)
  status                OutreachStatus             @default(DRAFTED)
  copiedAt              DateTime?
  manuallySentAt        DateTime?
  declinedAt            DateTime?
  providerExternalId    String?
  providerPayload       Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceRecords    VehicleMaintenanceRecord[]

  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, vehicleId, createdAt])
}

model Appointment {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  scheduledStart        DateTime
  scheduledEnd          DateTime
  status                AppointmentStatus          @default(REQUESTED)
  totalLaborMinutes     Int
  totalPriceCents       Int
  source                AppointmentSource          @default(MANUAL)
  notes                 String?
  cancelledAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  services              AppointmentService[]
  maintenanceRecords    VehicleMaintenanceRecord[]

  @@index([shopId, scheduledStart, status])
  @@unique([shopId, vehicleId, scheduledStart])
}

model AppointmentService {
  id                    String                    @id @default(cuid())
  shopId                String
  appointmentId         String
  serviceDefinitionId   String?
  maintenanceRecordId   String?
  serviceName           String
  laborMinutes          Int
  priceCents            Int
  createdAt             DateTime                  @default(now())
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointment           Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceDefinition     ServiceDefinition?        @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, appointmentId])
  @@unique([appointmentId, serviceName])
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}
