generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
}

enum ShopStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  WATCHLIST
  PAUSED
  ARCHIVED
}

enum ContactMethod {
  SMS
  EMAIL
  CALL
}

enum MaintenanceStatus {
  HEALTHY
  DUE_SOON
  DUE
  OVERDUE
  PAUSED
  COMPLETED
}

enum OutreachStatus {
  NEEDS_OUTREACH
  DRAFTED
  MANUALLY_SENT
  SCHEDULED
  RESPONDED
  SNOOZED
  DECLINED
  STOPPED
}

enum OutreachChannel {
  PHONE
  TEXT
  EMAIL
  CALL
  IN_PERSON
  OTHER
}

enum CustomerResponseStatus {
  NO_RESPONSE
  INTERESTED
  WANTS_CALLBACK
  BOOKED
  DECLINED
  NOT_NOW
  WRONG_CONTACT
  DO_NOT_CONTACT
}

enum AppointmentStatus {
  TENTATIVE
  SCHEDULED
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  AUTOMATION
  CUSTOMER_BOOKING
  MANUAL
  IMPORTED
}

enum AppointmentAttributionSource {
  MAINTIVA_OUTREACH
  MANUAL_SHOP_ENTRY
  IMPORTED_APPOINTMENT
  OTHER
}

enum OpportunitySource {
  DUE_MAINTENANCE
  OVERDUE_MAINTENANCE
  DECLINED_WORK
  DEFERRED_WORK
  REACTIVATION
}

enum OpportunityStage {
  IDENTIFIED
  CONTACTED
  RESPONDED
  BOOKED
  COMPLETED
  LOST
}

enum OpportunityPriority {
  HIGH
  MEDIUM
  LOW
}

enum ImportType {
  CUSTOMERS
  VEHICLES
  SERVICE_HISTORY
  DECLINED_WORK
  APPOINTMENTS
  COMBINED
}

enum ImportStatus {
  PREVIEWED
  COMPLETED
  PARTIAL
  FAILED
}

enum DeclinedWorkStatus {
  OPEN
  BOOKED
  COMPLETED
  DECLINED
  SNOOZED
}

model User {
  id          String           @id
  email       String           @unique
  name        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships ShopMembership[]
  outreachRecords OutreachRecord[]
  importHistory ImportHistoryRecord[]
  auditLogs   AuditLog[]
}

model Shop {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  phone                String?
  email                String?
  address              String?
  timezone             String                     @default("America/New_York")
  dailyBayHours        Int                        @default(64)
  status               ShopStatus                 @default(ONBOARDING)
  isDemo               Boolean                    @default(false)
  onboardingCompletedAt DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  memberships          ShopMembership[]
  customers            Customer[]
  vehicles             Vehicle[]
  serviceDefinitions   ServiceDefinition[]
  maintenanceRecords   VehicleMaintenanceRecord[]
  serviceHistoryRecords ServiceHistoryRecord[]
  declinedWorkRecords  DeclinedWorkRecord[]
  revenueOpportunities MaintenanceRevenueOpportunity[]
  outreachRecords      OutreachRecord[]
  appointments         Appointment[]
  appointmentServices  AppointmentService[]
  importHistory        ImportHistoryRecord[]
  importRows           ImportRowRecord[]
  auditLogs            AuditLog[]

  @@index([status])
}

model ShopMembership {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      UserRole @default(OWNER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId, isActive])
  @@index([shopId, role])
}

model Customer {
  id                   String                 @id @default(cuid())
  shopId               String
  firstName            String
  lastName             String
  phone                String?
  email                String?
  preferredContact     ContactMethod          @default(SMS)
  smsConsent           Boolean                @default(false)
  emailConsent         Boolean                @default(false)
  callConsent          Boolean                @default(false)
  address              String?
  notes                String?
  status               CustomerStatus         @default(ACTIVE)
  customerScore        Int                    @default(70)
  lifetimeRevenueCents Int                    @default(0)
  lastVisit            DateTime?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  shop                 Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicles             Vehicle[]
  serviceHistoryRecords ServiceHistoryRecord[]
  declinedWorkRecords  DeclinedWorkRecord[]
  revenueOpportunities MaintenanceRevenueOpportunity[]
  outreachRecords      OutreachRecord[]
  appointments         Appointment[]

  @@index([shopId, status])
  @@index([shopId, archivedAt])
  @@index([shopId, lastName, firstName])
}

model Vehicle {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  year                  Int
  make                  String
  model                 String
  vin                   String?
  licensePlate          String?
  engine                String?
  trim                  String?
  vehicleType           String?
  currentMileage        Int                        @default(0)
  estimatedAnnualMileage Int?
  overallHealth         Int                        @default(80)
  lastServiceDate       DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  maintenanceRecords    VehicleMaintenanceRecord[]
  serviceHistoryRecords ServiceHistoryRecord[]
  declinedWorkRecords   DeclinedWorkRecord[]
  revenueOpportunities  MaintenanceRevenueOpportunity[]
  outreachRecords       OutreachRecord[]
  appointments          Appointment[]

  @@index([shopId, customerId])
  @@index([shopId, archivedAt])
  @@unique([shopId, vin])
}

model ServiceDefinition {
  id                           String                     @id @default(cuid())
  shopId                       String
  name                         String
  category                     String
  defaultMileageInterval       Int
  defaultTimeIntervalMonths    Int
  defaultNotificationThreshold Int                        @default(10)
  estimatedLaborMinutes        Int
  defaultPriceCents            Int
  description                  String?
  isActive                     Boolean                    @default(true)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  shop                         Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  maintenanceRecords           VehicleMaintenanceRecord[]
  serviceHistoryRecords        ServiceHistoryRecord[]
  appointmentServices          AppointmentService[]

  @@unique([shopId, name])
  @@index([shopId, isActive])
}

model VehicleMaintenanceRecord {
  id                              String                 @id @default(cuid())
  shopId                          String
  vehicleId                       String
  serviceDefinitionId             String
  serviceName                     String
  lastCompletedDate               DateTime?
  lastCompletedMileage            Int?
  recommendedMileageInterval      Int
  recommendedTimeIntervalMonths   Int
  notificationThreshold           Int                    @default(10)
  priceCents                      Int
  laborMinutes                    Int
  status                          MaintenanceStatus      @default(HEALTHY)
  outreachStatus                  OutreachStatus         @default(NEEDS_OUTREACH)
  outreachRecordId                String?
  appointmentId                   String?
  archivedAt                      DateTime?
  notes                           String?
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt
  shop                            Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicle                         Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDefinition               ServiceDefinition      @relation(fields: [serviceDefinitionId], references: [id], onDelete: Restrict)
  outreachRecord                  OutreachRecord?        @relation(fields: [outreachRecordId], references: [id], onDelete: SetNull)
  appointment                     Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  serviceHistoryRecords           ServiceHistoryRecord[]
  appointmentServices             AppointmentService[]
  revenueOpportunities            MaintenanceRevenueOpportunity[]

  @@unique([shopId, vehicleId, serviceDefinitionId])
  @@index([shopId, vehicleId, status])
  @@index([shopId, outreachStatus])
}

model ServiceHistoryRecord {
  id                    String                    @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  serviceDefinitionId   String?
  maintenanceRecordId   String?
  serviceName           String
  completedAt           DateTime
  mileage               Int?
  laborMinutes          Int                       @default(0)
  priceCents            Int                       @default(0)
  notes                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDefinition     ServiceDefinition?        @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, customerId, completedAt])
  @@index([shopId, vehicleId, completedAt])
}

model DeclinedWorkRecord {
  id                      String             @id @default(cuid())
  shopId                  String
  customerId              String
  vehicleId               String
  serviceName             String
  declinedAt              DateTime
  recommendedPriceCents   Int
  laborMinutes            Int
  advisorNotes            String?
  status                  DeclinedWorkStatus @default(OPEN)
  outreachStatus          OutreachStatus     @default(NEEDS_OUTREACH)
  appointmentId           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  shop                    Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer                Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle                 Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  appointment             Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  revenueOpportunities    MaintenanceRevenueOpportunity[]

  @@index([shopId, status, declinedAt])
  @@index([shopId, customerId])
  @@index([shopId, vehicleId])
}

model MaintenanceRevenueOpportunity {
  id                    String              @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  maintenanceRecordId   String?
  declinedWorkRecordId  String?
  source                OpportunitySource
  stage                 OpportunityStage    @default(IDENTIFIED)
  priority              OpportunityPriority @default(MEDIUM)
  explanation           String
  priorityReason        String
  estimatedRevenueCents Int
  estimatedLaborMinutes Int
  dueDate               DateTime?
  dueMileage            Int?
  daysOverdue           Int                 @default(0)
  milesOverdue          Int                 @default(0)
  lastActivityAt        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)
  declinedWorkRecord    DeclinedWorkRecord? @relation(fields: [declinedWorkRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, stage, priority])
  @@index([shopId, source])
  @@index([shopId, vehicleId])
}

model OutreachRecord {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  message               String
  channel               OutreachChannel            @default(TEXT)
  status                OutreachStatus             @default(DRAFTED)
  copiedAt              DateTime?
  manuallySentAt        DateTime?
  declinedAt            DateTime?
  responseStatus        CustomerResponseStatus @default(NO_RESPONSE)
  followUpDate          DateTime?
  appointmentId         String?
  performedByUserId     String?
  providerExternalId    String?
  providerPayload       Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  appointment           Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  performedBy           User?                      @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  maintenanceRecords    VehicleMaintenanceRecord[]

  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, vehicleId, createdAt])
}

model Appointment {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  scheduledStart        DateTime
  scheduledEnd          DateTime
  status                AppointmentStatus          @default(REQUESTED)
  totalLaborMinutes     Int
  totalPriceCents       Int
  source                AppointmentSource          @default(MANUAL)
  attributionSource     AppointmentAttributionSource @default(MANUAL_SHOP_ENTRY)
  opportunityId         String?
  outreachRecordId      String?
  completedRevenueCents Int?
  completedLaborMinutes Int?
  notes                 String?
  cancelledAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  services              AppointmentService[]
  maintenanceRecords    VehicleMaintenanceRecord[]
  declinedWorkRecords   DeclinedWorkRecord[]
  outreachRecords       OutreachRecord[]

  @@index([shopId, scheduledStart, status])
  @@index([shopId, status])
  @@index([shopId, customerId, scheduledStart])
  @@index([shopId, vehicleId, scheduledStart])
  @@index([shopId, opportunityId])
  @@unique([shopId, vehicleId, scheduledStart])
}

model AppointmentService {
  id                    String                    @id @default(cuid())
  shopId                String
  appointmentId         String
  serviceDefinitionId   String?
  maintenanceRecordId   String?
  serviceName           String
  laborMinutes          Int
  priceCents            Int
  createdAt             DateTime                  @default(now())
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointment           Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceDefinition     ServiceDefinition?        @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, appointmentId])
  @@unique([appointmentId, serviceName])
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

model ImportHistoryRecord {
  id             String       @id @default(cuid())
  shopId         String
  userId         String?
  fileName       String
  importType     ImportType
  status         ImportStatus @default(COMPLETED)
  importedAt     DateTime     @default(now())
  totalRows      Int          @default(0)
  successfulRows Int          @default(0)
  duplicateRows  Int          @default(0)
  updatedRows    Int          @default(0)
  skippedRows    Int          @default(0)
  failedRows     Int          @default(0)
  errorReportUrl String?
  errorReport    Json?
  createdAt      DateTime     @default(now())
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  rows           ImportRowRecord[]

  @@index([shopId, importedAt])
  @@index([shopId, importType])
}

model ImportRowRecord {
  id                    String              @id @default(cuid())
  shopId                String
  importHistoryRecordId String
  rowNumber             Int
  action                String
  status                String
  entityType            String?
  errorMessage          String?
  sourceRow             Json
  normalizedRow         Json
  createdAt             DateTime            @default(now())
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  importHistoryRecord   ImportHistoryRecord @relation(fields: [importHistoryRecordId], references: [id], onDelete: Cascade)

  @@unique([importHistoryRecordId, rowNumber])
  @@index([shopId, importHistoryRecordId])
  @@index([shopId, status])
}
