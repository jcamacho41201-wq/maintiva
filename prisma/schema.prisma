generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
}

enum ShopStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  WATCHLIST
  PAUSED
  ARCHIVED
}

enum ContactMethod {
  SMS
  EMAIL
  CALL
}

enum MaintenanceStatus {
  HEALTHY
  DUE_SOON
  DUE
  OVERDUE
  PAUSED
  COMPLETED
}

enum OutreachStatus {
  NEEDS_OUTREACH
  DRAFTED
  MANUALLY_SENT
  SCHEDULED
  RESPONDED
  SNOOZED
  DECLINED
  STOPPED
}

enum OutreachChannel {
  PHONE
  TEXT
  EMAIL
  CALL
  IN_PERSON
  OTHER
}

enum CustomerResponseStatus {
  NO_RESPONSE
  INTERESTED
  WANTS_CALLBACK
  BOOKED
  DECLINED
  NOT_NOW
  WRONG_CONTACT
  DO_NOT_CONTACT
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  AUTOMATION
  CUSTOMER_BOOKING
  MANUAL
  IMPORTED
}

enum AppointmentAttributionSource {
  MAINTIVA_OUTREACH
  MANUAL_SHOP_ENTRY
  IMPORTED_APPOINTMENT
  OTHER
}

enum BookingMode {
  INSTANT
  REQUEST
}

enum BookingIntakeType {
  WAIT
  DROP_OFF
}

enum ServiceBookingIntakeOption {
  WAIT_ONLY
  DROP_OFF_ONLY
  EITHER
}

enum CustomerBookingLinkStatus {
  ACTIVE
  REVOKED
  COMPLETED
  EXPIRED
}

enum OpportunitySource {
  DUE_MAINTENANCE
  OVERDUE_MAINTENANCE
  DECLINED_WORK
  DEFERRED_WORK
  REACTIVATION
}

enum OpportunityStage {
  IDENTIFIED
  CONTACTED
  RESPONDED
  BOOKED
  COMPLETED
  LOST
}

enum OpportunityPriority {
  HIGH
  MEDIUM
  LOW
}

enum ImportType {
  CUSTOMERS
  VEHICLES
  SERVICE_HISTORY
  DECLINED_WORK
  APPOINTMENTS
  COMBINED
}

enum ImportStatus {
  PREVIEWED
  COMPLETED
  PARTIAL
  FAILED
}

enum DeclinedWorkStatus {
  OPEN
  BOOKED
  COMPLETED
  DECLINED
  SNOOZED
}

enum TimeIntervalUnit {
  DAYS
  MONTHS
  YEARS
}

enum OutreachThresholdType {
  MILES_BEFORE_DUE
  DAYS_BEFORE_DUE
  PERCENT_REMAINING
}

enum MileageReadingSource {
  SHOP_REPAIR_ORDER
  SHOP_MANUAL_ENTRY
  SERVICE_HISTORY_IMPORT
  CUSTOMER_REPORTED
  APPOINTMENT_INTAKE
  CORRECTION
  OTHER
}

enum MileageVerificationStatus {
  VERIFIED
  CUSTOMER_REPORTED
  IMPORTED
  UNVERIFIED
  EXCLUDED
}

enum MileageAnomalyStatus {
  NONE
  NEEDS_REVIEW
  RESOLVED
}

enum DrivingProfileEstimateSource {
  SHOP_VERIFIED_READINGS
  IMPORTED_READINGS
  CUSTOMER_REPORTED
  VERIFIED_PLUS_DEFAULT
  SHOP_DEFAULT
  MANUAL_OVERRIDE
}

enum DrivingProfileConfidence {
  LOW
  MEDIUM
  HIGH
}

model User {
  id          String           @id
  email       String           @unique
  name        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships ShopMembership[]
  outreachRecords OutreachRecord[]
  importHistory ImportHistoryRecord[]
  auditLogs   AuditLog[]
  createdMaintenanceRecords VehicleMaintenanceRecord[] @relation("MaintenanceRecordCreatedBy")
  updatedMaintenanceRecords VehicleMaintenanceRecord[] @relation("MaintenanceRecordUpdatedBy")
  mileageReadingsRecorded VehicleMileageReading[] @relation("MileageReadingRecordedBy")
  drivingProfilesCustomerReported VehicleDrivingProfile[] @relation("DrivingProfileCustomerReportedBy")
  drivingProfilesManualOverride VehicleDrivingProfile[] @relation("DrivingProfileManualOverrideSetBy")
  bookingLinksCreated CustomerBookingLink[] @relation("BookingLinkCreatedBy")
}

model Shop {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  phone                String?
  email                String?
  address              String?
  timezone             String                     @default("America/New_York")
  dailyBayHours        Int                        @default(64)
  defaultAnnualMileage Int                        @default(12500)
  status               ShopStatus                 @default(ONBOARDING)
  isDemo               Boolean                    @default(false)
  onboardingCompletedAt DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  memberships          ShopMembership[]
  customers            Customer[]
  vehicles             Vehicle[]
  serviceDefinitions   ServiceDefinition[]
  maintenanceRecords   VehicleMaintenanceRecord[]
  serviceHistoryRecords ServiceHistoryRecord[]
  declinedWorkRecords  DeclinedWorkRecord[]
  revenueOpportunities MaintenanceRevenueOpportunity[]
  outreachRecords      OutreachRecord[]
  appointments         Appointment[]
  appointmentServices  AppointmentService[]
  importHistory        ImportHistoryRecord[]
  importRows           ImportRowRecord[]
  auditLogs            AuditLog[]
  mileageReadings      VehicleMileageReading[]
  drivingProfiles      VehicleDrivingProfile[]
  bookingSettings      ShopBookingSettings?
  bookingWindows       ShopBookingWindow[]
  bookingBlackouts     ShopBookingBlackout[]
  serviceBookingRules  ServiceBookingRule[]
  serviceBookingWindows ServiceBookingWindow[]
  customerBookingLinks CustomerBookingLink[]
  appointmentChanges   AppointmentChangeRecord[]

  @@index([status])
}

model ShopMembership {
  id        String   @id @default(cuid())
  shopId    String
  userId    String
  role      UserRole @default(OWNER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shopId, userId])
  @@index([userId, isActive])
  @@index([shopId, role])
}

model Customer {
  id                   String                 @id @default(cuid())
  shopId               String
  firstName            String
  lastName             String
  phone                String?
  email                String?
  preferredContact     ContactMethod          @default(SMS)
  smsConsent           Boolean                @default(false)
  emailConsent         Boolean                @default(false)
  callConsent          Boolean                @default(false)
  address              String?
  notes                String?
  status               CustomerStatus         @default(ACTIVE)
  customerScore        Int                    @default(70)
  lifetimeRevenueCents Int                    @default(0)
  lastVisit            DateTime?
  archivedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  shop                 Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicles             Vehicle[]
  serviceHistoryRecords ServiceHistoryRecord[]
  declinedWorkRecords  DeclinedWorkRecord[]
  revenueOpportunities MaintenanceRevenueOpportunity[]
  outreachRecords      OutreachRecord[]
  appointments         Appointment[]
  customerBookingLinks CustomerBookingLink[]

  @@index([shopId, status])
  @@index([shopId, archivedAt])
  @@index([shopId, lastName, firstName])
}

model Vehicle {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  year                  Int
  make                  String
  model                 String
  vin                   String?
  licensePlate          String?
  engine                String?
  trim                  String?
  vehicleType           String?
  currentMileage        Int                        @default(0)
  estimatedAnnualMileage Int?
  overallHealth         Int                        @default(80)
  lastServiceDate       DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  maintenanceRecords    VehicleMaintenanceRecord[]
  serviceHistoryRecords ServiceHistoryRecord[]
  declinedWorkRecords   DeclinedWorkRecord[]
  revenueOpportunities  MaintenanceRevenueOpportunity[]
  outreachRecords       OutreachRecord[]
  appointments          Appointment[]
  mileageReadings       VehicleMileageReading[]
  drivingProfile        VehicleDrivingProfile?
  customerBookingLinks  CustomerBookingLink[]

  @@index([shopId, customerId])
  @@index([shopId, archivedAt])
  @@unique([shopId, vin])
}

model ServiceDefinition {
  id                           String                     @id @default(cuid())
  shopId                       String
  name                         String
  category                     String
  defaultMileageInterval       Int?
  defaultTimeIntervalMonths    Int?
  defaultTimeIntervalValue     Int?
  defaultTimeIntervalUnit      TimeIntervalUnit           @default(MONTHS)
  defaultNotificationThreshold Int                        @default(10)
  estimatedLaborMinutes        Int
  defaultPriceCents            Int
  description                  String?
  isActive                     Boolean                    @default(true)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  shop                         Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  maintenanceRecords           VehicleMaintenanceRecord[]
  serviceHistoryRecords        ServiceHistoryRecord[]
  appointmentServices          AppointmentService[]
  bookingRule                  ServiceBookingRule?

  @@unique([shopId, name])
  @@index([shopId, isActive])
}

model VehicleMaintenanceRecord {
  id                              String                 @id @default(cuid())
  shopId                          String
  vehicleId                       String
  serviceDefinitionId             String?
  serviceName                     String
  customServiceName               String?
  customCategory                  String?
  lastCompletedDate               DateTime?
  lastCompletedMileage            Int?
  recommendedMileageInterval      Int?
  recommendedTimeIntervalMonths   Int?
  mileageIntervalOverride         Int?
  timeIntervalValueOverride       Int?
  timeIntervalUnitOverride        TimeIntervalUnit?
  notificationThreshold           Int                    @default(10)
  outreachThresholdType           OutreachThresholdType  @default(MILES_BEFORE_DUE)
  outreachThresholdValue          Int                    @default(500)
  priceCents                      Int
  laborMinutes                    Int
  priceOverrideCents              Int?
  laborMinutesOverride            Int?
  status                          MaintenanceStatus      @default(HEALTHY)
  outreachStatus                  OutreachStatus         @default(NEEDS_OUTREACH)
  outreachRecordId                String?
  appointmentId                   String?
  isActive                        Boolean                @default(true)
  archivedAt                      DateTime?
  notes                           String?
  createdByUserId                 String?
  updatedByUserId                 String?
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt
  shop                            Shop                   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicle                         Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDefinition               ServiceDefinition?     @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  outreachRecord                  OutreachRecord?        @relation(fields: [outreachRecordId], references: [id], onDelete: SetNull)
  appointment                     Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy                       User?                  @relation("MaintenanceRecordCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                       User?                  @relation("MaintenanceRecordUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  serviceHistoryRecords           ServiceHistoryRecord[]
  appointmentServices             AppointmentService[]
  revenueOpportunities            MaintenanceRevenueOpportunity[]

  @@index([shopId, vehicleId, status])
  @@index([shopId, vehicleId, isActive])
  @@index([shopId, vehicleId, serviceDefinitionId])
  @@index([shopId, outreachStatus])
}

model VehicleMileageReading {
  id                   String                    @id @default(cuid())
  shopId               String
  vehicleId            String
  readingMileage       Int
  readingDate          DateTime
  source               MileageReadingSource
  verificationStatus   MileageVerificationStatus @default(UNVERIFIED)
  anomalyStatus        MileageAnomalyStatus      @default(NONE)
  includedInForecast   Boolean                   @default(true)
  correctionReason     String?
  reviewNotes          String?
  sourceReferenceType  String?
  sourceReferenceId    String?
  recordedByUserId     String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  shop                 Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicle              Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  recordedBy           User?                     @relation("MileageReadingRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([shopId, vehicleId, readingDate])
  @@index([shopId, vehicleId, includedInForecast, anomalyStatus])
  @@index([shopId, sourceReferenceType, sourceReferenceId])
}

model VehicleDrivingProfile {
  id                            String                       @id @default(cuid())
  shopId                        String
  vehicleId                     String                       @unique
  customerReportedAnnualMileage Int?
  customerReportedAt            DateTime?
  customerReportedByUserId      String?
  calculatedAnnualMileage       Int
  estimateSource                DrivingProfileEstimateSource @default(SHOP_DEFAULT)
  confidence                    DrivingProfileConfidence     @default(LOW)
  confidenceReason              String
  manualAnnualMileageOverride   Int?
  manualOverrideReason          String?
  manualOverrideNotes           String?
  manualOverrideSetAt           DateTime?
  manualOverrideSetByUserId     String?
  lastCalculatedAt              DateTime                     @default(now())
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  shop                          Shop                         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  vehicle                       Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerReportedBy            User?                        @relation("DrivingProfileCustomerReportedBy", fields: [customerReportedByUserId], references: [id], onDelete: SetNull)
  manualOverrideSetBy           User?                        @relation("DrivingProfileManualOverrideSetBy", fields: [manualOverrideSetByUserId], references: [id], onDelete: SetNull)

  @@index([shopId, confidence])
  @@index([shopId, estimateSource])
}

model ServiceHistoryRecord {
  id                    String                    @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  serviceDefinitionId   String?
  maintenanceRecordId   String?
  serviceName           String
  completedAt           DateTime
  mileage               Int?
  laborMinutes          Int                       @default(0)
  priceCents            Int                       @default(0)
  notes                 String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceDefinition     ServiceDefinition?        @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, customerId, completedAt])
  @@index([shopId, vehicleId, completedAt])
}

model DeclinedWorkRecord {
  id                      String             @id @default(cuid())
  shopId                  String
  customerId              String
  vehicleId               String
  serviceName             String
  declinedAt              DateTime
  recommendedPriceCents   Int
  laborMinutes            Int
  advisorNotes            String?
  status                  DeclinedWorkStatus @default(OPEN)
  outreachStatus          OutreachStatus     @default(NEEDS_OUTREACH)
  appointmentId           String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  shop                    Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer                Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle                 Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  appointment             Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  revenueOpportunities    MaintenanceRevenueOpportunity[]

  @@index([shopId, status, declinedAt])
  @@index([shopId, customerId])
  @@index([shopId, vehicleId])
}

model MaintenanceRevenueOpportunity {
  id                    String              @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  maintenanceRecordId   String?
  declinedWorkRecordId  String?
  source                OpportunitySource
  stage                 OpportunityStage    @default(IDENTIFIED)
  priority              OpportunityPriority @default(MEDIUM)
  explanation           String
  priorityReason        String
  estimatedRevenueCents Int
  estimatedLaborMinutes Int
  dueDate               DateTime?
  dueMileage            Int?
  daysOverdue           Int                 @default(0)
  milesOverdue          Int                 @default(0)
  lastActivityAt        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)
  declinedWorkRecord    DeclinedWorkRecord? @relation(fields: [declinedWorkRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, stage, priority])
  @@index([shopId, source])
  @@index([shopId, vehicleId])
}

model OutreachRecord {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  message               String
  channel               OutreachChannel            @default(TEXT)
  status                OutreachStatus             @default(DRAFTED)
  copiedAt              DateTime?
  manuallySentAt        DateTime?
  declinedAt            DateTime?
  responseStatus        CustomerResponseStatus @default(NO_RESPONSE)
  followUpDate          DateTime?
  appointmentId         String?
  bookingLinkId         String?
  performedByUserId     String?
  providerExternalId    String?
  providerPayload       Json?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  appointment           Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  bookingLink           CustomerBookingLink?        @relation("OutreachBookingLink", fields: [bookingLinkId], references: [id], onDelete: SetNull)
  performedBy           User?                      @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  maintenanceRecords    VehicleMaintenanceRecord[]
  customerBookingLinks  CustomerBookingLink[]       @relation("BookingLinkOutreachRecord")

  @@index([shopId, status, createdAt])
  @@index([shopId, customerId, createdAt])
  @@index([shopId, vehicleId, createdAt])
}

model Appointment {
  id                    String                     @id @default(cuid())
  shopId                String
  customerId            String
  vehicleId             String
  scheduledStart        DateTime
  scheduledEnd          DateTime
  status                AppointmentStatus          @default(REQUESTED)
  totalLaborMinutes     Int
  totalPriceCents       Int
  source                AppointmentSource          @default(MANUAL)
  attributionSource     AppointmentAttributionSource @default(MANUAL_SHOP_ENTRY)
  opportunityId         String?
  outreachRecordId      String?
  bookingLinkId         String?
  intakeType            BookingIntakeType?
  customerNotes         String?
  internalNotes         String?
  completedRevenueCents Int?
  completedLaborMinutes Int?
  notes                 String?
  cancelledAt           DateTime?
  requestedAt           DateTime?
  approvedAt            DateTime?
  declinedAt            DateTime?
  customerCancelledAt   DateTime?
  rescheduledAt         DateTime?
  completedAt           DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  shop                  Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  services              AppointmentService[]
  maintenanceRecords    VehicleMaintenanceRecord[]
  declinedWorkRecords   DeclinedWorkRecord[]
  outreachRecords       OutreachRecord[]
  bookingLink           CustomerBookingLink?        @relation("AppointmentBookingLink", fields: [bookingLinkId], references: [id], onDelete: SetNull)
  customerBookingLinks  CustomerBookingLink[]       @relation("BookingLinkAppointment")
  changes               AppointmentChangeRecord[]

  @@index([shopId, scheduledStart, status])
  @@index([shopId, bookingLinkId])
  @@unique([shopId, vehicleId, scheduledStart])
}

model AppointmentService {
  id                    String                    @id @default(cuid())
  shopId                String
  appointmentId         String
  serviceDefinitionId   String?
  maintenanceRecordId   String?
  serviceName           String
  laborMinutes          Int
  priceCents            Int
  createdAt             DateTime                  @default(now())
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointment           Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceDefinition     ServiceDefinition?        @relation(fields: [serviceDefinitionId], references: [id], onDelete: SetNull)
  maintenanceRecord     VehicleMaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: SetNull)

  @@index([shopId, appointmentId])
  @@unique([appointmentId, serviceName])
}

model AuditLog {
  id          String   @id @default(cuid())
  shopId      String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

model ShopBookingSettings {
  id                                String   @id @default(cuid())
  shopId                            String   @unique
  onlineBookingEnabled              Boolean  @default(true)
  minimumNoticeMinutes              Int      @default(1440)
  maximumAdvanceDays                Int      @default(30)
  defaultBufferBeforeMinutes        Int      @default(0)
  defaultBufferAfterMinutes         Int      @default(15)
  maximumSimultaneousAppointments   Int      @default(2)
  cancellationCutoffMinutes         Int      @default(1440)
  reschedulingCutoffMinutes         Int      @default(1440)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt
  shop                              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model ShopBookingWindow {
  id          String   @id @default(cuid())
  shopId      String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, dayOfWeek, isActive])
}

model ShopBookingBlackout {
  id          String   @id @default(cuid())
  shopId      String
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  isFullDay   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, startsAt, endsAt])
}

model ServiceBookingRule {
  id                          String                     @id @default(cuid())
  shopId                      String
  serviceDefinitionId         String                     @unique
  bookingEnabled              Boolean                    @default(false)
  bookingMode                 BookingMode                @default(REQUEST)
  estimatedDurationMinutes    Int
  bufferBeforeMinutes         Int                        @default(0)
  bufferAfterMinutes          Int                        @default(15)
  allowedIntakeType           ServiceBookingIntakeOption @default(EITHER)
  minimumNoticeMinutes        Int?
  maximumAdvanceDays          Int?
  maximumSimultaneousBookings Int?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  shop                        Shop                       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceDefinition           ServiceDefinition          @relation(fields: [serviceDefinitionId], references: [id], onDelete: Cascade)
  windows                     ServiceBookingWindow[]

  @@index([shopId, bookingEnabled])
}

model ServiceBookingWindow {
  id                   String             @id @default(cuid())
  shopId               String
  serviceBookingRuleId String
  dayOfWeek            Int
  startMinute          Int
  endMinute            Int
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  shop                 Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceBookingRule   ServiceBookingRule @relation(fields: [serviceBookingRuleId], references: [id], onDelete: Cascade)

  @@index([shopId, dayOfWeek, isActive])
  @@index([serviceBookingRuleId])
}

model CustomerBookingLink {
  id                    String                    @id @default(cuid())
  shopId                String
  tokenHash             String                    @unique
  customerId            String
  vehicleId             String
  opportunityId         String?
  maintenanceRecordIds  String[]                  @default([])
  declinedWorkRecordIds String[]                  @default([])
  status                CustomerBookingLinkStatus @default(ACTIVE)
  expiresAt             DateTime
  revokedAt             DateTime?
  usedAt                DateTime?
  lastViewedAt          DateTime?
  bookingCompletedAt    DateTime?
  createdByUserId       String?
  outreachRecordId      String?
  appointmentId         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  shop                  Shop                      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer              Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy             User?                     @relation("BookingLinkCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  outreachRecord        OutreachRecord?           @relation("BookingLinkOutreachRecord", fields: [outreachRecordId], references: [id], onDelete: SetNull)
  appointment           Appointment?              @relation("BookingLinkAppointment", fields: [appointmentId], references: [id], onDelete: SetNull)
  outreachRecords       OutreachRecord[]          @relation("OutreachBookingLink")
  appointments          Appointment[]             @relation("AppointmentBookingLink")
  appointmentChanges    AppointmentChangeRecord[]

  @@index([shopId, customerId])
  @@index([shopId, vehicleId])
  @@index([shopId, opportunityId])
  @@index([shopId, status, expiresAt])
}

model AppointmentChangeRecord {
  id              String               @id @default(cuid())
  shopId          String
  appointmentId   String
  bookingLinkId   String?
  action          String
  previousStart   DateTime?
  previousEnd     DateTime?
  newStart        DateTime?
  newEnd          DateTime?
  reason          String?
  createdAt       DateTime             @default(now())
  shop            Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointment     Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  bookingLink     CustomerBookingLink? @relation(fields: [bookingLinkId], references: [id], onDelete: SetNull)

  @@index([shopId, appointmentId, createdAt])
}

model ImportHistoryRecord {
  id             String       @id @default(cuid())
  shopId         String
  userId         String?
  fileName       String
  importType     ImportType
  status         ImportStatus @default(COMPLETED)
  importedAt     DateTime     @default(now())
  totalRows      Int          @default(0)
  successfulRows Int          @default(0)
  duplicateRows  Int          @default(0)
  updatedRows    Int          @default(0)
  skippedRows    Int          @default(0)
  failedRows     Int          @default(0)
  errorReportUrl String?
  errorReport    Json?
  createdAt      DateTime     @default(now())
  shop           Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  rows           ImportRowRecord[]

  @@index([shopId, importedAt])
  @@index([shopId, importType])
}

model ImportRowRecord {
  id                    String              @id @default(cuid())
  shopId                String
  importHistoryRecordId String
  rowNumber             Int
  action                String
  status                String
  entityType            String?
  errorMessage          String?
  sourceRow             Json
  normalizedRow         Json
  createdAt             DateTime            @default(now())
  shop                  Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  importHistoryRecord   ImportHistoryRecord @relation(fields: [importHistoryRecordId], references: [id], onDelete: Cascade)

  @@unique([importHistoryRecordId, rowNumber])
  @@index([shopId, importHistoryRecordId])
  @@index([shopId, status])
}
